[node name="ReconFlare" type="Node3D" node_paths=PackedStringArray("flare", "zone", "zone_ring", "sweep")]
script = ExtResource("1_ability")
display_name = "Šlehat blesky"
description = "Vystřelíš světlici do 30 m. Na 6 s osvítí zónu o 9 m: označí a zpomalí nepřátele, kteří dostávají +50 % poškození hlavní zbraní."
base_cooldown = 14.0
accent_color = Color(0.75, 1, 0.95, 1)
synth_activate = &"seismic_throw"
flare = NodePath("Flare")
zone = NodePath("Zone")
zone_ring = NodePath("Zone/Ring")
sweep = NodePath("Zone/Sweep")
icon = ExtResource("icon_px")

