[node name="PartyWithoutMe" type="Node3D" node_paths=PackedStringArray("speaker_template")]
script = ExtResource("1")
display_name = "Party without me"
description = "Umístíš reprák na volnou podlahu do 14 m a můžeš odejít. Osm sekund pulzuje do 4,5 m: 14 mrazivého poškození každých 0,8 s a zpomalení na 55 %. Stěny i jiné patro blokují zásah. Rank zvyšuje sílu a dobu párty; zkrátí cooldown."
