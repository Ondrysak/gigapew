[node name="Crossfader" type="Node3D" node_paths=PackedStringArray("stage", "wave", "boundary", "platter_left", "platter_right", "fader")]
script = ExtResource("1")
display_name = "Crossfader"
description = "Rozložíš gramce: šest pulzů po 12 poškození do 6 m střídavě přitahuje dav a odhazuje jej ven. Zóna zůstane na podlaze 3 s; stěny a jiné patro pulz zastaví. Rank přidá pulz, poškození a trvání; zkrátí cooldown. Ban zóna zesílí zásah."
base_cooldown = 18.0
accent_color = Color(0.12, 0.85, 1, 1)
synth_activate = &"overdrive"
icon = ExtResource("icon")
stage = NodePath("Stage")
boundary = NodePath("Stage/Boundary")
wave = NodePath("Stage/Wave")
platter_left = NodePath("Stage/Deck/Left")
platter_right = NodePath("Stage/Deck/Right")
fader = NodePath("Stage/Deck/Fader")

