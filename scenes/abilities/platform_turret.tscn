script = ExtResource("1_ability")
display_name = "Platform Turret"
description = "Drop a heavy turret where you aim (up to 8 m); its landing hits for 40. For 15 s it fires piercing tracers at the nearest enemy within 24 m: 28 damage each, 8 shots a second, through 3 enemies."
base_cooldown = 22.0
accent_color = Color(0.5, 1, 0.4, 1)
synth_activate = &"seismic_throw"
turret = NodePath("Turret")
turret_yaw = NodePath("Turret/Yaw")
turret_pitch = NodePath("Turret/Yaw/Pitch")
muzzle = NodePath("Turret/Yaw/Pitch/Muzzle")
