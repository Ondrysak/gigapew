[node name="RepairDrone" type="Node3D" node_paths=PackedStringArray("drone", "rotor", "bubble", "beam_template", "pulse_template")]
script = ExtResource("1_ability")
display_name = "Repair Drone"
description = "Deploy a drone for 8 s: a 2.5 s shield on launch, 40 HP healed over the duration, and a zap at the nearest enemy within 9 m every 0.5 s for 18 damage."
base_cooldown = 24.0
accent_color = Color(0.45, 1, 0.8, 1)
synth_activate = &"overdrive"
drone = NodePath("Drone")
rotor = NodePath("Drone/Rotor")
bubble = NodePath("Bubble")
