[node name="SuppressionBarrage" type="Node3D" node_paths=PackedStringArray("flash_template", "scorch_template")]
script = ExtResource("1_ability")
display_name = "Suppression Barrage"
description = "Call in a barrage: 30 shells hammer three rings around you (4, 7 and 10 m), each blasting 55 damage over 2.6 m and knocking enemies back."
base_cooldown = 16.0
accent_color = Color(1, 0.6, 0.25, 1)
synth_activate = &"autocannon"
flash_template = NodePath("FlashTemplate")
scorch_template = NodePath("ScorchTemplate")
icon = ExtResource("icon_px")

[node name="FlashTemplate" type="Node3D" parent="."]
visible = false

[node name="Core" type="MeshInstance3D" parent="FlashTemplate"]
