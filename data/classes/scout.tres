[resource]
script = ExtResource("1_class")
move_speed_multiplier = 0.12
pickup_radius = 1.0
id = &"scout"
display_name = "Luďas"
tagline = "DJ legenda. Poslední party, první průšvih."
description = "Rychlá legenda ze septiku. Kolobežka Duplex prorazí bezpečnou cestu, Šlehat blesky odhalí a zpomalí dav a Vytrhnu hajzl z podlahy zakončí skok drtivým dopadem. Ban zóna stáhne nepřátele, Valhalla kryje ústup. +12 % rychlosti a větší dosah sběru."
accent_color = Color(0.72, 0.53, 0.29, 1)
primary_weapon = ExtResource("3_pulse")
ability_scenes = Array[PackedScene]([ExtResource("5_ability"), ExtResource("6_alt"), ExtResource("7_alt"), ExtResource("gravity"), ExtResource("barrier")])
unlock_cost = 0
unlock_currency = &"shard"
icon = ExtResource("icon_px")
