[resource]
script = ExtResource("1_class")
move_speed_multiplier = 0.12
pickup_radius = 1.0
id = &"scout"
display_name = "Scout"
tagline = "Fast, precise, gone before they close in."
description = "Pulse tags targets for the Rail; Shock Baton sweeps and stuns close threats without ammunition. +12% speed and wider pickup reach. Blink Dash clears a lane and grants a heartbeat of invulnerability."
accent_color = Color(0.3, 0.95, 1, 1)
starting_weapons = Array[ExtResource("2_weapon")]([ExtResource("3_pulse"), ExtResource("4_rail"), ExtResource("third")])
ability_scene = ExtResource("5_ability")
alternate_abilities = Array[PackedScene]([ExtResource("6_alt"), ExtResource("7_alt")])
alternate_ability_costs = PackedInt32Array(3, 5)
unlock_cost = 0
unlock_currency = &"shard"
icon = ExtResource("icon_px")
