[resource]
script = ExtResource("1_class")
move_speed_multiplier = 0.12
pickup_radius = 1.0
id = &"scout"
display_name = "Scout"
tagline = "Fast, precise, gone before they close in."
description = "A mobile precision kit: Blink Dash cuts a safe lane, Recon Flare exposes and slows a pack, and Grapple Vault launches into a damaging landing. Gravity Well gathers threats; Pulse Barrier protects a retreat. +12% speed and wider pickup reach."
accent_color = Color(0.3, 0.95, 1, 1)
primary_weapon = ExtResource("3_pulse")
ability_scenes = Array[PackedScene]([ExtResource("5_ability"), ExtResource("6_alt"), ExtResource("7_alt"), ExtResource("gravity"), ExtResource("barrier")])
unlock_cost = 0
unlock_currency = &"shard"
icon = ExtResource("icon_px")
