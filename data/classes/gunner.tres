[resource]
script = ExtResource("1_class")
move_speed_multiplier = -0.05
max_health_bonus = 30
armor = 1.0
id = &"gunner"
display_name = "Vítek ultras"
tagline = "Tvrdej, hlasitej. Z cesty neuhne."
description = "První řada před hernou. Jsem god odrazí nepřátele při úplné nezranitelnosti, Blesky ze stropu ostřelují okolí a Heroic Ragnarok zrychlí průraznou palbu. Ban zóna stáhne dav, Valhalla kryje postup. +30 zdraví, +1 zbroj a −5 % rychlosti."
accent_color = Color(0.62, 0.4, 0.28, 1)
primary_weapon = ExtResource("3_minigun")
ability_scenes = Array[PackedScene]([ExtResource("5_ability"), ExtResource("6_alt"), ExtResource("7_alt"), ExtResource("gravity"), ExtResource("barrier")])
unlock_cost = 6
unlock_currency = &"shard"
icon = ExtResource("icon_px")
