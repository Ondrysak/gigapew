armor = 1.0
id = &"gunner"
display_name = "Gunner"
tagline = "Plant your feet. Hold the trigger. Never stop."
description = "Minigun feeds the grenade meter; Autocannon breaks packs; Scatter clears close threats. +30 health, +1 armor and -5% speed. Bulwark grants an invulnerable dome and knockback pulse."
