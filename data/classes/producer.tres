[gd_resource type="Resource" script_class="ClassDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/class_definition.gd" id="1_class"]
[ext_resource type="Resource" path="res://data/weapons/maschine.tres" id="maschine"]
[ext_resource type="PackedScene" path="res://scenes/abilities/brucelee.tscn" id="brucelee"]
[ext_resource type="PackedScene" path="res://scenes/abilities/crossfader.tscn" id="crossfader"]
[ext_resource type="PackedScene" path="res://scenes/abilities/party_without_me.tscn" id="party"]
[ext_resource type="PackedScene" path="res://scenes/abilities/gravity_well.tscn" id="gravity"]
