[resource]
script = ExtResource("1_class")
id = &"producer"
display_name = "Real producer"
tagline = "Přes maschine jsem real producer."
description = "Rozjede párty s vlastní Maschine: elektrický zvukový brokovnicový výboj. Brucelee krátce kryje a rozdává směrové údery, Crossfader střídá přitažení a odhoz davu. Party without me nechá na podlaze mrazivý reprák, zatímco ty odejdeš. Ban zóna a Valhalla doplní všech pět skillů."
accent_color = Color(0.64, 0.24, 0.86, 1)
primary_weapon = ExtResource("maschine")
ability_scenes = Array[PackedScene]([ExtResource("brucelee"), ExtResource("crossfader"), ExtResource("party"), ExtResource("gravity"), ExtResource("barrier")])
unlock_cost = 0
icon = ExtResource("icon")
