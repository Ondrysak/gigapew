[resource]
script = ExtResource("1_class")
damage_multiplier = 0.05
mining_multiplier = 1.5
id = &"driller"
display_name = "Driller"
tagline = "Burn the swarm. Crack the rock. Bank the loot."
description = "An explosive area-control kit: Seismic Charge demolishes a pack, Drill Dash carves a protected path with an eruption, and Magma Trail leaves damaging ground behind. Gravity Well gathers threats; Pulse Barrier protects close-range mining. +5% damage and +150% mining."
