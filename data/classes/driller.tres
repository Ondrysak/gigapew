[resource]
script = ExtResource("1_class")
damage_multiplier = 0.05
mining_multiplier = 1.5
id = &"driller"
display_name = "Mikoláš hajzldítě"
tagline = "Septik je doma. Automat je pokladna."
description = "Ničení má v rodném listu. Odpočet do autodestrukce rozmetá dav, Ilegal street racer prorazí chráněnou cestu s erupcí a Brikulóza zanechá škodlivou stopu. Ban zóna stáhne nepřátele, Valhalla kryje páčení zblízka. +5 % poškození a +150 % rychlosti páčení."
accent_color = Color(0.65, 0.43, 0.25, 1)
primary_weapon = ExtResource("3_flamethrower")
ability_scenes = Array[PackedScene]([ExtResource("5_ability"), ExtResource("6_alt"), ExtResource("7_alt"), ExtResource("gravity"), ExtResource("barrier")])
unlock_cost = 10
unlock_currency = &"shard"
icon = ExtResource("icon_px")
