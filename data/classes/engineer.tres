[gd_resource type="Resource" script_class="ClassDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/data/class_definition.gd" id="1_class"]
[ext_resource type="Script" path="res://scripts/data/weapon_definition.gd" id="2_weapon"]
[ext_resource type="Resource" path="res://data/weapons/pulse.tres" id="3_pulse"]
[ext_resource type="Resource" path="res://data/weapons/autocannon.tres" id="4_autocannon"]
[ext_resource type="Resource" path="res://data/weapons/baton.tres" id="third"]
[ext_resource type="PackedScene" path="res://scenes/abilities/overdrive.tscn" id="5_ability"]
[ext_resource type="Script" path="res://scripts/progression/upgrade_definition.gd" id="6_upgrade"]
[ext_resource type="Resource" path="res://data/upgrades/sentry.tres" id="7_sentry"]
