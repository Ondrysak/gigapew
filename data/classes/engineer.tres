[resource]
script = ExtResource("1_class")
cooldown_multiplier = -0.1
id = &"engineer"
display_name = "Engineer"
tagline = "Let the machines do the killing."
description = "Pulse exposes targets, Autocannon bursts packs and Shock Baton stuns nearby threats without ammunition. Starts with a Sentry, -10% auto cooldown. Overdrive boosts every automated weapon."
accent_color = Color(0.5, 1, 0.38, 1)
starting_weapons = Array[ExtResource("2_weapon")]([ExtResource("3_pulse"), ExtResource("4_autocannon"), ExtResource("third")])
starting_upgrades = Array[ExtResource("6_upgrade")]([ExtResource("7_sentry")])
ability_scene = ExtResource("5_ability")
alternate_abilities = Array[PackedScene]([ExtResource("8_alt"), ExtResource("9_alt")])
alternate_ability_costs = PackedInt32Array(6, 8)
unlock_cost = 14
unlock_currency = &"shard"
icon = ExtResource("icon_px")
